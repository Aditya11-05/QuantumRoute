# ============================================================
# QuantumRoute backend configuration
# Copy this file to .env and adjust values as needed.
# Never commit the real .env file.
# ============================================================

APP_NAME=QuantumRoute
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# PROJECT_MODE controls whether we try to hit live OpenStreetMap /
# Overpass servers ("live") or always use the cached / synthetic
# graph and synthetic traffic ("demo"). "demo" is the safe default
# for SIH stage demos and for any machine without reliable internet.
PROJECT_MODE=demo

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo region used for OSMnx graph_from_place() when PROJECT_MODE=live.
DEMO_REGION="Kashipur, Uttarakhand, India"

# Where the cached/pickled road graph is stored so we don't re-download
# from OSM on every startup.
GRAPH_CACHE_PATH=../data/osm/graph_cache.graphml

# Path to the trained congestion/speed prediction model.
MODEL_PATH=../data/models/congestion_model.txt

# Number of simulated-annealing iterations for the QUBO solver.
OPTIMIZATION_ITERATIONS=2000

# Default multi-objective cost weights (must sum to ~1.0; the API also
# lets a client override these per-request).
WEIGHT_TRAVEL_TIME=0.35
WEIGHT_CONGESTION=0.30
WEIGHT_DISTANCE=0.15
WEIGHT_FUEL=0.10
WEIGHT_INTERSECTION=0.05
WEIGHT_INCIDENT=0.05

# Random seed used for synthetic graph/traffic generation so demos are
# reproducible.
DEMO_RANDOM_SEED=42
